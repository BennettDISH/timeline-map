# Database
DATABASE_URL=postgresql://username:password@localhost:5432/fantasy_map_timeline

# Signs the session cookie (fleet-kit; SESSION_SECRET wins when both are set) and reads the
# old-format tokens until their reader goes. Generate a secure random string.
JWT_SECRET=your-super-secret-jwt-key-here

# Environment
NODE_ENV=development

# SSO (server-side). Set all three to enable "Sign in with Waypoint".
# The OAuth flow is built entirely server-side — there are NO VITE_ client vars anymore.
# Optionally set APP_BASE_URL to force an exact redirect_uri; otherwise the request origin is used.
AUTH_SERVICE_URL=
SSO_CLIENT_ID=
SSO_CLIENT_SECRET=
# APP_BASE_URL=https://your-app.example.com

# Railway specific (these will be auto-set by Railway)
PORT=3001
# The Forge (optional per-world AI mind) — entirely inert unless GEMINI_API_KEY is set.
# GEMINI_API_KEY=
# FORGE_ENABLED=0            # kill-switch: set 0 to turn the Forge off without removing the key
# FORGE_TEXT_MODEL=gemini-3.1-pro-preview
# FORGE_IMAGE_MODEL=gemini-2.5-flash-image

# Voices (optional). The first key found speaks — Gemini, then OpenAI, then ElevenLabs — or
# pin one with VOICE_PROVIDER. Gemini/OpenAI voices are steerable by a written description;
# ElevenLabs has the widest voice choice and is the only one that generates ambience.
# VOICE_PROVIDER=gemini      # gemini | openai | elevenlabs
# OPENAI_API_KEY=
# ELEVENLABS_API_KEY=
# VOICE_ENABLED=0            # kill-switch without removing keys
# VOICE_TTS_MODEL_GEMINI=gemini-2.5-flash-tts
# VOICE_TTS_MODEL_ELEVENLABS=eleven_multilingual_v2
# VOICE_TTS_MODEL_OPENAI=gpt-4o-mini-tts
# VOICE_TTS_MODEL=              # pins one model id for the chosen provider, whichever it is

# Daily spend caps on the paid features (server/lib/spend.js), counted in the database per UTC day.
# A Forge use is a chat turn or one painting (in a turn or from Paint); a voice recording is a
# spoken line or an ambience. _CAP is per account, _CAP_GUEST per guest (0 shuts the feature for
# guests), _CEILING is everyone but the admins together. Admins (ADMIN_CENTRAL_USER_IDS) are never
# capped. Whole numbers; unset keeps the default shown.
# FORGE_DAILY_CAP=40
# FORGE_DAILY_CAP_GUEST=5
# FORGE_DAILY_CEILING=150
# VOICE_DAILY_CAP=20
# VOICE_DAILY_CAP_GUEST=3
# VOICE_DAILY_CEILING=100
# Image uploads, the same way in megabytes a day (counted in KB, so a small image is not 1 MB)
# UPLOAD_DAILY_CAP=250
# UPLOAD_DAILY_CAP_GUEST=25
# UPLOAD_DAILY_CEILING=2000

# Internal bug-tracker widget (injected server-side on DM pages only; optional)
BUG_WIDGET_KEY=

# Who is admin: Waypoint (central) user ids, comma-separated. Unset = central id 1; set but
# empty = nobody. Guests are never admin.
# ADMIN_CENTRAL_USER_IDS=1

# Hosts allowed to frame the public Player View (/p/*), comma-separated; Spellforge's Map tab
# by default (its railway.app name and spellforge.bennettdishman.com). Set, it replaces
# the default. The DM UI can never be framed.
# EMBED_ORIGINS=https://spellforge.example

# Cloudflare R2 image storage — all five turn it on; with any unset, uploads answer 503 and nothing is kept
# in Postgres (see docs/R2-SETUP.md). R2_PUBLIC_URL is the bucket's custom domain (atlas-media.…).
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET=
# R2_PUBLIC_URL=
# Only while stored URLs still point at the old r2.dev address (scripts/rewrite-media-host.js), comma separated:
# R2_LEGACY_PUBLIC_URLS=

# Guests (made through Waypoint). A guest nobody has seen for GUEST_RETENTION_DAYS (default 30,
# the same window Waypoint prunes its guests by) is removed with its worlds and their R2 objects.
# GUEST_RETENTION_DAYS=30
# GUEST_CLEANUP_ENABLED=false
