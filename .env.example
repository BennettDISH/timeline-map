# Database
DATABASE_URL=postgresql://username:password@localhost:5432/fantasy_map_timeline

# JWT Secret (generate a secure random string)
JWT_SECRET=your-super-secret-jwt-key-here

# How long a session token is valid (any jsonwebtoken duration: 30m, 12h, 7d).
# Kept short on purpose: the token lives in the browser, so this is the window a stolen
# one is usable for. /api/auth/me re-issues past the halfway mark, so an app in active
# use never hits it — only an idle browser has to sign in again. Defaults to 24h.
# JWT_EXPIRES_IN=24h

# Environment
NODE_ENV=development

# Frontend URL (for CORS)
FRONTEND_URL=http://localhost:5173

# SSO (server-side). Set all three to enable "Sign in with bennettdishman.com".
# The OAuth flow is built entirely server-side — there are NO VITE_ client vars anymore.
# Optionally set APP_BASE_URL to force an exact redirect_uri; otherwise the request origin is used.
AUTH_SERVICE_URL=
SSO_CLIENT_ID=
SSO_CLIENT_SECRET=
# APP_BASE_URL=https://your-app.example.com

# Railway specific (these will be auto-set by Railway)
PORT=3001
# The Forge (optional per-world AI mind) — entirely inert unless GEMINI_API_KEY is set.
# GEMINI_API_KEY=
# FORGE_ENABLED=0            # kill-switch: set 0 to turn the Forge off without removing the key
# FORGE_TEXT_MODEL=gemini-2.5-pro
# FORGE_IMAGE_MODEL=gemini-2.5-flash-image

# Voices (optional). The first key found speaks — Gemini, then OpenAI, then ElevenLabs — or
# pin one with VOICE_PROVIDER. Gemini/OpenAI voices are steerable by a written description;
# ElevenLabs has the widest voice choice and is the only one that generates ambience.
# VOICE_PROVIDER=gemini      # gemini | openai | elevenlabs
# OPENAI_API_KEY=
# ELEVENLABS_API_KEY=
# VOICE_ENABLED=0            # kill-switch without removing keys
# VOICE_TTS_MODEL=gemini-2.5-flash-tts
# VOICE_TTS_MODEL_OPENAI=gpt-4o-mini-tts

# Internal bug-tracker widget (injected server-side on DM pages only; optional)
BUG_WIDGET_KEY=

# Cloudflare R2 image storage — all five make R2 the store; leave unset to keep images in Postgres (see docs/R2-SETUP.md)
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET=
# R2_PUBLIC_URL=
